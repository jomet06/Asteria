generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// USER PROFILE
// ========================================

model Profile {
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  timezone    String   @default("Asia/Jakarta")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  projects                 Project[]
  tasks                    Task[]
  calendarEvents           CalendarEvent[]
  googleCalendarConnection GoogleCalendarConnection?
  googleCalendarSources    GoogleCalendarSource[]
  googleEventMirrors       GoogleEventMirror[]

  @@map("profiles")
}

// ========================================
// PROJECT
// ========================================

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?  @db.Text
  isArchived  Boolean  @default(false) @map("is_archived")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@index([ownerId, createdAt], map: "projects_owner_created_idx")
  @@map("projects")
}

// ========================================
// TASK
// ========================================

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  ownerId     String       @map("owner_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueAt       DateTime?    @map("due_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner   Profile  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  subtasks       Subtask[]
  dailyPlanItems DailyPlanItem[]
  timeBlocks     CalendarEvent[]

  @@unique([id, ownerId], map: "tasks_id_owner_unique")
  @@index([ownerId, status], map: "tasks_owner_status_idx")
  @@index([ownerId, dueAt], map: "tasks_owner_due_at_idx")
  @@index([projectId], map: "tasks_project_idx")
  @@map("tasks")
}

// ========================================
// SUBTASK
// ========================================

model Subtask {
  id          String   @id @default(uuid()) @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  title       String   @db.VarChar(200)
  isCompleted Boolean  @default(false) @map("is_completed")
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position], map: "subtasks_task_position_idx")
  @@map("subtasks")
}

// ========================================
// DAILY PLANNER
// ========================================

model DailyPlanItem {
  id          String   @id @default(uuid()) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  plannedDate DateTime @map("planned_date") @db.Date
  position    Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@unique([taskId, plannedDate], map: "daily_plan_task_date_unique")
  @@index([ownerId, plannedDate, position], map: "daily_plan_owner_date_position_idx")
  @@map("daily_plan_items")
}

// ========================================
// CALENDAR EVENT — M3
// ========================================

model CalendarEvent {
  id          String  @id @default(uuid()) @db.Uuid
  ownerId     String  @map("owner_id") @db.Uuid
  title       String  @db.VarChar(200)
  description String? @db.Text
  location    String? @db.VarChar(255)

  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  timezone String  @default("Asia/Jakarta") @db.VarChar(64)
  isAllDay Boolean @default(false) @map("is_all_day")

  recurrenceRule String?   @map("recurrence_rule") @db.Text
  taskId         String?   @map("task_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  originalStart  DateTime? @map("original_start") @db.Timestamptz(3)
  isCancelled    Boolean   @default(false) @map("is_cancelled")

  // Two-way sync with the dedicated Asteria calendar in Google.
  googleEventId String?  @map("google_event_id") @db.VarChar(512)
  syncState     String   @default("local") @map("sync_state") @db.VarChar(32)
  syncError     String?  @map("sync_error") @db.Text

  task       Task?           @relation(fields: [taskId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "calendar_events_task_owner_fkey")
  parent     CalendarEvent?  @relation("Occurrences", fields: [parentId, ownerId], references: [id, ownerId], onDelete: Cascade, map: "calendar_events_parent_owner_fkey")
  exceptions CalendarEvent[] @relation("Occurrences")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([id, ownerId], map: "calendar_events_id_owner_unique")
  @@unique([parentId, originalStart], map: "calendar_events_occurrence_unique")
  @@index([ownerId, startsAt], map: "calendar_events_owner_starts_idx")
  @@index([taskId, ownerId], map: "calendar_events_task_owner_idx")
  @@index([ownerId, endsAt], map: "calendar_events_owner_ends_idx")
  @@index([ownerId, syncState], map: "calendar_events_owner_sync_state_idx")
  @@map("calendar_events")
}

// ========================================
// GOOGLE CALENDAR CONNECTION — M3.7.1
// ========================================

model GoogleCalendarConnection {
  ownerId               String   @id @map("owner_id") @db.Uuid
  googleAccountId       String   @map("google_account_id") @db.VarChar(255)
  googleEmail           String?  @map("google_email") @db.VarChar(320)
  refreshTokenEncrypted String   @map("refresh_token_encrypted") @db.Text
  grantedScopes         String   @map("granted_scopes") @db.Text
  // Dedicated secondary calendar ("Asteria") that receives pushed events.
  targetCalendarId      String?  @map("target_calendar_id") @db.VarChar(512)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sources GoogleCalendarSource[]

  @@map("google_calendar_connections")
}

model GoogleCalendarSource {
  id                 String   @id @default(uuid()) @db.Uuid
  ownerId            String   @map("owner_id") @db.Uuid
  connectionOwnerId  String   @map("connection_owner_id") @db.Uuid
  googleCalendarId   String   @map("google_calendar_id") @db.VarChar(512)
  name               String   @db.VarChar(255)
  isPrimary          Boolean  @default(false) @map("is_primary")
  selected           Boolean  @default(false)
  syncStatus         String   @default("idle") @map("sync_status") @db.VarChar(32)
  lastSuccessfulSync DateTime? @map("last_successful_sync") @db.Timestamptz(3)
  lastSyncError      String?  @map("last_sync_error") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner      Profile                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connection GoogleCalendarConnection @relation(fields: [connectionOwnerId], references: [ownerId], onDelete: Cascade)
  events     GoogleEventMirror[]

  @@unique([connectionOwnerId, googleCalendarId], map: "google_calendar_sources_connection_calendar_unique")
  @@index([ownerId, selected], map: "google_calendar_sources_owner_selected_idx")
  @@map("google_calendar_sources")
}

model GoogleEventMirror {
  id              String   @id @default(uuid()) @db.Uuid
  ownerId         String   @map("owner_id") @db.Uuid
  sourceId        String   @map("source_id") @db.Uuid
  googleEventId   String   @map("google_event_id") @db.VarChar(512)
  title           String   @db.VarChar(500)
  description     String?  @db.Text
  location        String?  @db.VarChar(1000)
  startsAt        DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(3)
  timezone        String   @db.VarChar(64)
  isAllDay        Boolean  @default(false) @map("is_all_day")
  htmlLink        String?  @map("html_link") @db.VarChar(2000)
  googleUpdatedAt DateTime? @map("google_updated_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner  Profile              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  source GoogleCalendarSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, googleEventId], map: "google_event_mirrors_source_event_unique")
  @@index([ownerId, startsAt], map: "google_event_mirrors_owner_starts_idx")
  @@index([sourceId, startsAt], map: "google_event_mirrors_source_starts_idx")
  @@map("google_event_mirrors")
}

// ========================================
// TASK STATUS
// ========================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// ========================================
// TASK PRIORITY
// ========================================

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
