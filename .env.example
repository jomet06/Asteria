# Safe placeholders only. Copy to .env.local and fill in your own values.
# .env.local is ignored by Git. Never commit passwords, tokens or real DB URLs.

# Required: Supabase Auth and application origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Required: server-only PostgreSQL connections. Confirm the target database first.
# DATABASE_URL is used by PrismaPg in lib/prisma.ts.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# DIRECT_URL is used by prisma7.config.ts for migrations.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require

# Optional: Hermes / Gemini. Default model: gemini-3.8-flash.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_BUDGET=512

# Optional: Google Calendar OAuth (independent of Supabase Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Generate exactly 64 hex characters locally; see docs/getting-started.md
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Optional: Discord DM gateway and outbound reminders
DISCORD_BOT_TOKEN=
DISCORD_INTERNAL_SECRET=
ASTERIA_INTERNAL_URL=http://127.0.0.1:3000

# Optional: dedicated notification scheduler. Configure only for an approved deployment.
NOTIFICATIONS_SCHEDULER_SECRET=
